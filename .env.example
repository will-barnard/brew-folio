# Set these as GLOBAL env vars in the Beachhead dashboard (no Target Service),
# because docker-compose.yml references them as ${VAR}.

DB_PASSWORD=change-me
# openssl rand -hex 32
FOLIO_ENC_KEY=
FOLIO_TZ=America/Chicago

# brew-bucket (optional — falls back to the brew-folio-files volume).
# Mint a key scoped to the uploads + backups buckets.
BREW_BUCKET_URL=
BREW_BUCKET_KEY=
BREW_BUCKET_BUCKET=uploads
BREW_BUCKET_BACKUP_BUCKET=backups

# Phase 2
DRYDOCK_BASE_URL=
DRYDOCK_API_KEY=
